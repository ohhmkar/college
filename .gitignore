# .gitignore (suggested for college project repos)

```gitignore
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor/IDE
.vscode
.idea/
*.sublime-workspace
*.sublime-project
*.iml

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
env/
ENV/
.Python
pip-selfcheck.json
.pytest_cache/

# Java
*.class
*.jar
*.war
*.ear
*.ctxt
target/
out/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# Go/Rust/C/C++
/bin/
/pkg/
/target/
*.o
*.obj
*.exe
*.dll
*.so
*.out

# Build / distribution
dist/
build/
*.egg-info/
.eggs/

# Logs and temp
*.log
*.tmp
*.cache
*.swp

# Secrets / env
.env
.env.*.local
*.pem
*.key

# Misc
coverage/
coverage.xml
.vagrant/

# Generated docs (Javadoc) in PSOOP submissions
PSOOP/**/doc/
```
