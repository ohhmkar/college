# Exclude generated Javadoc assets from GitHub language statistics
PSOOP/**/doc/** linguist-generated=true

# Git LFS — large binary files
# Uncomment these after running: brew install git-lfs && git lfs install
# Then re-migrate existing files per the instructions in CLAUDE.md
#
*.pdf filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.doc filter=lfs diff=lfs merge=lfs -text
*.dwg filter=lfs diff=lfs merge=lfs -text
*.dwt filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
